{
  "name": "system-one-router",
  "version": "0.4.5",
  "type": "module",
  "files": [
    "extensions",
    "!extensions/*.test.ts",
    "LICENSE",
    "UPSTREAM.md",
    "model-router.example.json",
    "README.md"
  ],
  "description": "Smart per-turn model router for Pi that optimizes your AI budget and usage limits by dynamically switching LLM tiers based on task complexity, budget, and phase awareness.",
  "keywords": [
    "pi-package",
    "pi",
    "model-router",
    "llm",
    "coding-agent",
    "extension"
  ],
  "license": "MIT",
  "author": "devinat1",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./extensions/index.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "tsc": "tsc --noEmit",
    "build": "tsc",
    "prepublishOnly": "npm run tsc",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
